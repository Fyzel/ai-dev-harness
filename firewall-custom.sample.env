# Sample manual egress override for init-firewall.sh.
#
# Copy this file to firewall-custom.env (gitignored — never commit real
# hosts/ports).
#
# Format: "<tcp|udp> <ipv4-or-cidr> <port>" entries, separated by ";" and/or
# newlines (either works — pick whichever reads better). Every entry needs an
# explicit protocol AND port — there is no wildcard or whole-host form. A
# malformed entry fails firewall init instead of being silently skipped or
# silently widened. See .devcontainer/init-firewall.sh and
# .devcontainer/README.md for details.
FIREWALL_EXTRA_RULES="
tcp 192.168.1.50 11434;
udp 192.168.1.60 53"

# IMPORTANT — how you load this file changes what works:
#
# `docker run --env-file` / `podman run --env-file` parse the file line by
# line with NO shell quoting support (this is Docker's own documented
# behavior, not a bug here) — a multi-line quoted value like the one above
# gets mangled, not preserved. --env-file only works if FIREWALL_EXTRA_RULES
# is kept on a single physical line, e.g.:
#   FIREWALL_EXTRA_RULES="tcp 192.168.1.50 11434;udp 192.168.1.60 53"
#
# To use the prettier multi-line form above, source this file with bash
# instead (bash parses the quoting correctly) and pass the resulting env var
# through with a bare `-e`:
#   set -a; source firewall-custom.env; set +a
#   podman run --rm -it --cap-add=NET_ADMIN --cap-add=NET_RAW \
#     -v claude-code-config:/home/node/.claude \
#     -v gh-config:/home/node/.config/gh \
#     -v "$PWD:/workspace:Z" \
#     -e FIREWALL_EXTRA_RULES \
#     ghcr.io/fyzel/ai-dev-harness:latest
